# Copie ce fichier en ".env" puis remplis les valeurs.
# NE METS JAMAIS de vraies clés dans .env.example (ce fichier peut être partagé).

# Clé de signature des sessions (mets une longue valeur aléatoire)
SECRET_KEY=change-me-with-a-long-random-string

# Base de données (SQLite par défaut)
DATABASE_URL=sqlite:///jobhub.db

# Offres de démonstration au premier lancement (1 = oui, 0 = non)
USE_DEMO=1

# Scraping automatique toutes les X heures
SCRAPE_INTERVAL_HOURS=6

# Emails (optionnel). Gmail/Outlook : utilise un "mot de passe d'application"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Chatbot Claude (optionnel). Sans clé, le chatbot répond avec des règles.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
